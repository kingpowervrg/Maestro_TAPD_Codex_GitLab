#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  repo-full-checkout validate-reference <repository-path> <expected-remote-url>
  repo-full-checkout require-current <repository-path> <remote-url> <branch>
  repo-full-checkout refresh-task-ref <repository-path> <remote-url> <task-repo> <branch>
  repo-full-checkout materialize <repository-path> <remote-url> <target-path> <branch> [path1,path2]
  repo-full-checkout install-agent-context <project-root> <workspace-root>

Validates a complete local Git reference repository and materializes an
independent task checkout from it. The requested branch must already exist in
the reference at the same SHA as the remote; this helper never fetches that
branch into the task workspace. Sparse checkout paths are optional. It can also
expose repository-owned agent guidance and skills before Codex starts.
EOF
}

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-64}"
}

validate_argument() {
  value="$1"
  label="$2"

  if [ -z "$value" ]; then
    fail "$label must not be empty"
  fi

  case "$value" in
    *$'\n'*|*$'\r'*) fail "$label must not contain newlines" ;;
  esac
}

trim_path() {
  path="$1"
  path="${path#"${path%%[![:space:]]*}"}"
  path="${path%"${path##*[![:space:]]}"}"
  printf '%s' "$path"
}

validate_sparse_path() {
  path="$1"

  [ -n "$path" ] || fail "Sparse checkout paths must not contain empty entries"

  case "$path" in
    /*|.|./*|../*|*/../*|*/..|-*)
      fail "Sparse checkout paths must be safe repository-relative directories: $path"
      ;;
    *$'\n'*|*$'\r'*|*\\*)
      fail "Sparse checkout paths must not contain newlines, NULs, or backslashes: $path"
      ;;
  esac

  IFS='/' read -r -a path_segments <<<"$path"
  for path_segment in "${path_segments[@]}"; do
    case "$path_segment" in
      ""|"."|"..")
        fail "Sparse checkout paths must be safe repository-relative directories: $path"
        ;;
    esac
  done
}

parse_sparse_paths() {
  sparse_path_spec="$1"
  sparse_paths=()

  sparse_path_spec="$(trim_path "$sparse_path_spec")"
  [ -n "$sparse_path_spec" ] || return 0

  case "$sparse_path_spec" in
    ','*|*',') fail "Sparse checkout paths must not contain empty entries" ;;
  esac

  IFS=',' read -r -a raw_sparse_paths <<<"$sparse_path_spec"
  for raw_sparse_path in "${raw_sparse_paths[@]}"; do
    sparse_path="$(trim_path "$raw_sparse_path")"
    validate_sparse_path "$sparse_path"
    sparse_paths+=("$sparse_path")
  done

  [ "${#sparse_paths[@]}" -gt 0 ] || fail "Sparse checkout paths must not be empty"
}

validate_reference() {
  reference_repo="$1"
  expected_remote_url="$2"

  validate_argument "$reference_repo" "repository path"
  validate_argument "$expected_remote_url" "expected remote URL"

  [ -d "$reference_repo" ] || fail "Complete checkout reference is not a directory: $reference_repo" 74
  reference_repo="$(cd "$reference_repo" && pwd -P)"

  git -C "$reference_repo" rev-parse --git-dir >/dev/null 2>&1 ||
    fail "Complete checkout reference is not a Git repository: $reference_repo" 74

  [ "$(git -C "$reference_repo" rev-parse --is-shallow-repository)" = "false" ] ||
    fail "Complete checkout reference must not be shallow: $reference_repo" 74

  [ "$(git -C "$reference_repo" config --bool --get core.sparseCheckout 2>/dev/null || true)" != "true" ] ||
    fail "Complete checkout reference must not use sparse checkout: $reference_repo" 74

  promisor_config="$(git -C "$reference_repo" config --get-regexp '^remote\..*\.promisor$' 2>/dev/null || true)"
  partial_filter_config="$(git -C "$reference_repo" config --get-regexp '^remote\..*\.partialclonefilter$' 2>/dev/null || true)"

  [ -z "$promisor_config" ] || fail "Complete checkout reference must not be a promisor clone: $reference_repo" 74
  [ -z "$partial_filter_config" ] || fail "Complete checkout reference must not be a partial clone: $reference_repo" 74

  configured_remote="$(git -C "$reference_repo" remote get-url origin 2>/dev/null || true)"
  [ "$configured_remote" = "$expected_remote_url" ] ||
    fail "Complete checkout reference origin does not match SOURCE_REPO_URL" 74

  printf '%s\n' "$reference_repo"
}

reference_branch_sha() {
  reference_repo="$1"
  branch="$2"

  if git -C "$reference_repo" rev-parse --verify --quiet "refs/remotes/origin/${branch}^{commit}" >/dev/null; then
    git -C "$reference_repo" rev-parse "refs/remotes/origin/${branch}^{commit}"
    return 0
  fi

  if git -C "$reference_repo" rev-parse --verify --quiet "refs/heads/${branch}^{commit}" >/dev/null; then
    git -C "$reference_repo" rev-parse "refs/heads/${branch}^{commit}"
    return 0
  fi

  return 1
}

remote_branch_sha() {
  remote_url="$1"
  branch="$2"
  remote_sha="$(GIT_TERMINAL_PROMPT=0 git ls-remote --exit-code "$remote_url" "refs/heads/$branch" | awk 'NR == 1 { print $1 }')" || return 1
  [ -n "$remote_sha" ] || return 1
  printf '%s\n' "$remote_sha"
}

reference_update_command() {
  reference_repo="$1"
  branch="$2"
  printf 'git -C "%s" fetch origin "+refs/heads/%s:refs/remotes/origin/%s"' "$reference_repo" "$branch" "$branch"
}

require_current() {
  reference_repo="$1"
  remote_url="$2"
  branch="$3"

  validate_argument "$reference_repo" "repository path"
  validate_argument "$remote_url" "remote URL"
  validate_argument "$branch" "branch"
  git check-ref-format "refs/heads/$branch" >/dev/null 2>&1 ||
    fail "Invalid task checkout branch: $branch"

  reference_repo="$(validate_reference "$reference_repo" "$remote_url")"
  update_command="$(reference_update_command "$reference_repo" "$branch")"

  if ! local_sha="$(reference_branch_sha "$reference_repo" "$branch")"; then
    fail "Complete checkout reference has no refs/remotes/origin/$branch or refs/heads/$branch. Update it without switching its worktree: $update_command. Refusing to fetch the branch inside the task workspace." 74
  fi

  if ! remote_sha="$(remote_branch_sha "$remote_url" "$branch")"; then
    fail "Unable to resolve origin/$branch" 1
  fi

  if [ "$local_sha" != "$remote_sha" ]; then
    fail "Complete checkout reference for $branch is $local_sha but origin/$branch is $remote_sha. Update SOURCE_REPO_LOCAL_REFERENCE without switching its worktree: $update_command. Refusing to fetch the branch inside the task workspace." 74
  fi

  printf '%s\n' "$local_sha"
}

refresh_task_ref() {
  reference_repo="$1"
  remote_url="$2"
  task_repo="$3"
  branch="$4"
  local_sha="$(require_current "$reference_repo" "$remote_url" "$branch")"

  if [ ! -e "$task_repo/.git" ]; then
    return 0
  fi

  current_sha="$(git -C "$task_repo" rev-parse --verify --quiet "refs/remotes/origin/${branch}^{commit}" || true)"
  if [ "$current_sha" = "$local_sha" ]; then
    return 0
  fi

  git -C "$task_repo" cat-file -e "${local_sha}^{commit}" >/dev/null 2>&1 ||
    fail "Task workspace cannot see $local_sha from the complete checkout reference. Remove the task workspace and retry. Refusing to fetch the branch inside the task workspace." 74

  git -C "$task_repo" update-ref "refs/remotes/origin/$branch" "$local_sha"
}

materialize() {
  reference_repo="$1"
  remote_url="$2"
  target_path="$3"
  branch="$4"
  sparse_path_spec="${5:-}"

  validate_argument "$reference_repo" "repository path"
  validate_argument "$remote_url" "remote URL"
  validate_argument "$target_path" "target path"
  validate_argument "$branch" "branch"

  case "$target_path" in
    /*) fail "Task checkout target must be relative to the workspace" ;;
    ../*|*/../*|*/..) fail "Task checkout target must stay below the workspace" ;;
  esac

  git check-ref-format "refs/heads/$branch" >/dev/null 2>&1 ||
    fail "Invalid task checkout branch: $branch"

  parse_sparse_paths "$sparse_path_spec"

  [ ! -e "$target_path" ] || fail "Task checkout target already exists: $target_path" 74
  initializing_path="${target_path}.initializing.$$"
  [ ! -e "$initializing_path" ] || fail "Task checkout staging path already exists: $initializing_path" 74

  cleanup_materialization() {
    status="$?"
    trap - EXIT HUP INT TERM
    rm -rf -- "$initializing_path"
    exit "$status"
  }
  trap cleanup_materialization EXIT HUP INT TERM

  # Compare the reference with the remote before creating any task checkout.
  # Object transfer stays outside the task: a stale or missing branch must be
  # fetched into the reference repository, never with a filtered task fetch.
  local_sha="$(require_current "$reference_repo" "$remote_url" "$branch")"

  GIT_LFS_SKIP_SMUDGE=1 git clone --shared --no-checkout -- "$reference_repo" "$initializing_path"
  git -C "$initializing_path" remote set-url origin "$remote_url"
  git -C "$initializing_path" update-ref "refs/remotes/origin/$branch" "$local_sha"
  if [ "${#sparse_paths[@]}" -gt 0 ]; then
    git -C "$initializing_path" sparse-checkout set --no-cone -- "${sparse_paths[@]}"
  fi
  GIT_LFS_SKIP_SMUDGE=1 git -C "$initializing_path" checkout --force -B "$branch" \
    --track "refs/remotes/origin/$branch"
  mv -- "$initializing_path" "$target_path"
  trap - EXIT HUP INT TERM
}

install_skill_root() {
  source_root="$1"
  source_label="$2"
  destination_root="$3"

  [ -d "$source_root" ] || return 0

  for skill_dir in "$source_root"/*; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    skill_name="$(basename "$skill_dir")"

    case "$skill_name" in
      *$'\n'*|*$'\r'*) fail "Repository skill directory names must not contain newlines" ;;
    esac

    destination="$destination_root/target-${source_label}-${skill_name}"
    [ ! -e "$destination" ] || fail "Repository skill destination already exists: $destination" 74
    cp -R -- "$skill_dir" "$destination"
  done
}

install_agent_context() {
  project_root="$1"
  workspace_root="$2"

  validate_argument "$project_root" "project root"
  validate_argument "$workspace_root" "workspace root"

  [ -d "$project_root" ] || fail "Configured project root is not a directory: $project_root" 74
  [ -d "$workspace_root/.codex/skills" ] || fail "Workspace Codex automation pack is missing" 74

  project_root="$(cd "$project_root" && pwd -P)"
  workspace_root="$(cd "$workspace_root" && pwd -P)"

  case "$project_root/" in
    "$workspace_root/repo/"*) ;;
    *) fail "Configured project root must stay below workspace repo/" 74 ;;
  esac

  relative_project_root="${project_root#"$workspace_root/"}"

  cat >"$workspace_root/AGENTS.md" <<EOF
# Target Repository Agent Guide

The complete target-project checkout is at \`$relative_project_root\`.
Before planning or editing, read \`$relative_project_root/AGENTS.md\` when it
exists and read \`$relative_project_root/.codex/rules/AGENTS.md\` when it exists.
For every file you inspect or modify, discover and follow every applicable
\`AGENTS.md\` from the target-project root down to that file's directory.

Repository-owned skills were copied into workspace \`.codex/skills\` before
this Codex session started. Use them whenever their descriptions match the
task. Start project discovery, builds, and tests in
\`$relative_project_root\`. If its guidance identifies sibling monorepo paths,
work in those paths under \`repo/\` and follow their applicable rules. Use
\`repo/\` as the checkout root for repository-level Git operations.
EOF

  install_skill_root "$project_root/.codex/skills" "codex" "$workspace_root/.codex/skills"
  install_skill_root "$project_root/.agents/skills" "agents" "$workspace_root/.codex/skills"
}

for executable in git cp mv rm; do
  command -v "$executable" >/dev/null 2>&1 || fail "repo-full-checkout requires $executable" 127
done

case "$1" in
  validate-reference)
    [ "$#" -eq 3 ] || { usage >&2; exit 64; }
    validate_reference "$2" "$3"
    ;;
  require-current)
    [ "$#" -eq 4 ] || { usage >&2; exit 64; }
    require_current "$2" "$3" "$4"
    ;;
  refresh-task-ref)
    [ "$#" -eq 5 ] || { usage >&2; exit 64; }
    refresh_task_ref "$2" "$3" "$4" "$5"
    ;;
  materialize)
    [ "$#" -ge 5 ] && [ "$#" -le 6 ] || { usage >&2; exit 64; }
    materialize "$2" "$3" "$4" "$5" "${6:-}"
    ;;
  install-agent-context)
    [ "$#" -eq 3 ] || { usage >&2; exit 64; }
    install_agent_context "$2" "$3"
    ;;
  *) usage >&2; exit 64 ;;
esac
