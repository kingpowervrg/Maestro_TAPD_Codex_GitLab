#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
extension_script="${script_dir}/../../extensions/maestro_tapd_gitlab_lite/bin/start"

if [[ ! -x "${extension_script}" ]]; then
  printf 'TAPD/GitLab Lite extension start script is unavailable: %s\n' "${extension_script}" >&2
  exit 1
fi

exec "${extension_script}" "$@"
