# Symphony / Maestro local environment template.
#
# Copy this file to a local, ignored file before filling secrets, for example:
#
#   cp .env.example .env.tapd.local
#   cp .env.example .env.linear.local
#
# Do not put real secrets in .env.example. Local files matching .env.* are
# ignored by git, except this tracked .env.example template.

# ── Common ────────────────────────────────────────────────────────────────
# Isolated workspace root used by real workflows.
# Example: $HOME/maestro-workspaces/tapd-cnb-codebuddy
SYMPHONY_WORKSPACE_ROOT=

# Optional: persistent shared bare object cache for repository-backed tasks.
# Defaults to $SYMPHONY_WORKSPACE_ROOT/.git-object-cache.
SYMPHONY_GIT_OBJECT_CACHE_ROOT=

# Optional: override agent credential store root.
SYMPHONY_AGENT_CREDENTIALS_STORE_ROOT=

# Optional Codex model override passed through app-server thread/start.
SYMPHONY_AGENT_MODEL=

# Maximum retry runs after an agent attempt fails or exhausts its turn budget.
# Capacity-only waiting does not increment this counter. Defaults to 3.
SYMPHONY_MAX_RETRY_ATTEMPTS=3

# TAPD/Git workspaces may need longer than the global 60-second default to
# refresh a large shallow repository before a run. Recommended: 5 minutes.
SYMPHONY_WORKSPACE_HOOK_TIMEOUT_MS=300000

# ── TAPD tracker ──────────────────────────────────────────────────────────
# Required for TAPD-backed workflows.
TAPD_API_USER=
TAPD_API_PASSWORD=
TAPD_WORKSPACE_ID=

# TAPD Story owner name used for routing. The tapd/git/codex launcher requires
# this value and will only dispatch Stories whose owner field contains it.
# Use the TAPD display name without the API's trailing semicolon.
TAPD_ASSIGNEE=

# Optional: TAPD comment author. If empty, the authenticated API user is used.
TAPD_COMMENT_AUTHOR=

# Optional: narrow TAPD workflow probing/scanning to one Story/workitem type.
TAPD_WORKITEM_TYPE_ID=

# Optional: enable new/reopened TAPD Bugs whose AI workflow field is
# "接受/处理". Use the API field key, for example custom_field_6.
TAPD_BUG_AI_WORKFLOW_FIELD=

# Optional: TAPD Bug "AI模型等级" field. Supported values are low, medium,
# high, and xhigh. Empty or unsupported values use medium.
TAPD_BUG_AI_MODEL_LEVEL_FIELD=

# ── Linear tracker ────────────────────────────────────────────────────────
# Required for Linear-backed workflows.
LINEAR_API_KEY=
LINEAR_PROJECT_SLUG=

# ── Source repository ─────────────────────────────────────────────────────
# Used by CNB/GitHub repo-provider workflows.
SOURCE_REPO_URL=
SOURCE_REPO_BASE_BRANCH=main
SOURCE_REPO_BRANCH_WORK_PREFIX=maestro/

# Optional override. Usually inferred from SOURCE_REPO_URL for standard
# GitHub/CNB clone URLs.
SOURCE_REPO_PROVIDER_REPOSITORY=

# Optional GitHub PR label requirement. Leave empty if not needed.
SOURCE_REPO_PROVIDER_REQUIRED_PR_LABEL=

# Optional read-only GitLab code search for tapd/git/codex. Use a token with
# read_api scope. API URL and project are inferred from SOURCE_REPO_URL.
GITLAB_API_TOKEN=
GITLAB_API_BASE_URL=
GITLAB_PROJECT_ID=

# ── CNB repo provider ─────────────────────────────────────────────────────
CNB_TOKEN=
CNB_GIT_USER_NAME=Maestro CNB
CNB_GIT_USER_EMAIL=maestro-cnb@example.invalid

# ── GitHub repo provider ──────────────────────────────────────────────────
# Either authenticate with `gh auth login`, or set one of these tokens locally.
GH_TOKEN=
GITHUB_TOKEN=

# ── CodeBuddy Code managed credential login ───────────────────────────────
# Used only when running `symphony accounts login codebuddy_code ...`.
CODEBUDDY_API_KEY=

# ── OpenCode managed credential login ─────────────────────────────────────
# Fill the provider key you use, then run the matching accounts login command.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
